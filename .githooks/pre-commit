#!/usr/bin/env sh
set -eu

if [ "${OPENCLAW_SKIP_HOOKS:-}" = "1" ]; then
  echo "OPENCLAW_SKIP_HOOKS=1 set; skipping pre-commit hook."
  exit 0
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
  nvm use >/dev/null
fi

echo "Running OpenClaw pre-commit guardrails..."
# Path-scoped architecture scans cap vitest at 1 worker and serialize on a
# git-common-dir lock (agentic-hook-runner.ts). Do not reach for the emergency
# hook bypass; this step timing out under parallel load is the defect the lock closes.
pnpm hooks:pre-commit
