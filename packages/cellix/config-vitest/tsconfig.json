{
  "extends": "@cellix/config-typescript/node",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "rootDir": ".",
    "types": [
      "node",
      "vitest"
    ],
    "composite": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "vitest.config.ts"
  ]
}
