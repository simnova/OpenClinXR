{
  "name": "@cellix/server-mongodb-memory-mock",
  "version": "1.0.0-openclinxr.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "cellix-tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "cellix-tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "mongodb": "catalog:",
    "mongodb-memory-server": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
