{
  "extends": "@cellix/config-typescript/base",
  "compilerOptions": {
    "rootDir": "src", "outDir": "dist", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest"], "composite": true, "noEmit": false,
    "declaration": true, "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test-support.ts", "**/*.spec.ts", "dist"]
}
