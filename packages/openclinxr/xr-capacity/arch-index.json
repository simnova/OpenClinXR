{
  "package": "xr-capacity",
  "name": "@openclinxr/xr-capacity",
  "entrypoint": "packages/openclinxr/xr-capacity/src/index.ts",
  "purpose": "Shared capacity evidence validation, scoped adjudication and bounded host workloads.",
  "exports": [
    "CAPACITY_LIMITS",
    "CapacityMetric",
    "CapacityRun",
    "EvaluationContext",
    "HOST_LIMITS",
    "compareRuns",
    "evaluateRun",
    "evaluateStopRules",
    "makeFixtureCampaign",
    "makeMetric",
    "makeRun",
    "parseRunRecord",
    "planCampaign",
    "runFixtureCampaign",
    "runHostWorkloads",
    "summarizeMetric",
    "validateRunRecord"
  ],
  "exportSummaries": {
    "CAPACITY_LIMITS": "Bounded input ceilings for capacity evidence validation.",
    "CapacityMetric": "Single measured or proxy observation series.",
    "CapacityRun": "Versioned capacity evidence record.",
    "EvaluationContext": "Legacy call shape only.",
    "HOST_LIMITS": "Bounded host workload ceilings for capacity ladders.",
    "compareRuns": "Only explicit axis differences are allowed; workload-equivalence hashes never waive silently.",
    "evaluateRun": "Revalidates typed callers too; outcomes are derived.",
    "evaluateStopRules": "Evaluates bounded pressure stop rules for a run.",
    "makeFixtureCampaign": "Deterministic software adversaries.",
    "makeMetric": "Small honest defaults for collectors; overrides are shallow and validated at the evidence boundary.",
    "makeRun": "Synthetic and provisional by default.",
    "parseRunRecord": "Strict JSON boundary.",
    "planCampaign": "Deterministic, bounded independent ladders plus a labeled single-thread interleaved contention screen.",
    "runFixtureCampaign": "Executes the deterministic fixture campaign.",
    "runHostWorkloads": "Executes real host work, never an OOM search.",
    "summarizeMetric": "Raw observations only; aggregate window quantiles retain their aggregate label.",
    "validateRunRecord": "Non-throwing capacity record validator."
  },
