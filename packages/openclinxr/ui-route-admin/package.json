{
  "name": "@openclinxr/ui-route-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./case-authoring-workbench": {
      "types": "./dist/case-authoring-workbench-entry.d.ts",
      "default": "./dist/case-authoring-workbench-entry.js"
    },
    "./environment-generation-queue-panel": {
      "types": "./dist/environment-generation-queue-panel-entry.d.ts",
      "default": "./dist/environment-generation-queue-panel-entry.js"
    },
    "./faculty-compile-lock": {
      "types": "./dist/faculty-compile-lock-entry.d.ts",
      "default": "./dist/faculty-compile-lock-entry.js"
    },
    "./faculty-compile-lock-types": {
      "types": "./dist/faculty-compile-lock-types-entry.d.ts",
      "default": "./dist/faculty-compile-lock-types-entry.js"
    },
    "./review-replay-readiness-summary-panel": {
      "types": "./dist/review-replay-readiness-summary-panel-entry.d.ts",
      "default": "./dist/review-replay-readiness-summary-panel-entry.js"
    },
    "./scenario-review-gate-panel": {
      "types": "./dist/scenario-review-gate-panel-entry.d.ts",
      "default": "./dist/scenario-review-gate-panel-entry.js"
    },
    "./seed-worldview-queue": {
      "types": "./dist/seed-worldview-queue-entry.d.ts",
      "default": "./dist/seed-worldview-queue-entry.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
