{
  "name": "@openclinxr/factory-stations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  },
  "files": [
    "dist",
    "src/**/*.py"
  ]
}
