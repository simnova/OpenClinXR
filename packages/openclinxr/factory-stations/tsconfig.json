{
  "extends": "@cellix/config-typescript/node",
  "compilerOptions": {
    "rootDir": "src",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "dist"
  ],
  "references": [
    {
      "path": "../compute-services-spec"
    },
    {
      "path": "../compute-slots"
    },
    {
      "path": "../service-local-compute"
    }
  ]
}
