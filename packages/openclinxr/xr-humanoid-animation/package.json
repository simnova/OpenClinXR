{
  "name": "@openclinxr/xr-humanoid-animation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stance-lock": {
      "types": "./dist/stance-lock.d.ts",
      "default": "./dist/stance-lock.js"
    },
    "./case-owned-approach-runtime": {
      "types": "./dist/case-owned-approach-runtime.d.ts",
      "default": "./dist/case-owned-approach-runtime.js"
    },
    "./mounted-approach-geometry": {
      "types": "./dist/mounted-approach-geometry.d.ts",
      "default": "./dist/mounted-approach-geometry.js"
    },
    "./station-bedside-approach": {
      "types": "./dist/station-bedside-approach.d.ts",
      "default": "./dist/station-bedside-approach.js"
    },
    "./locomotion-clip-playback": {
      "types": "./dist/locomotion-clip-playback.d.ts",
      "default": "./dist/locomotion-clip-playback.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@openclinxr/asset-registry": "workspace:*",
    "@openclinxr/xr-dialogue": "workspace:*",
    "@openclinxr/xr-pose": "workspace:*",
    "@openclinxr/xr-runtime-state": "workspace:*",
    "@openclinxr/xr-scene": "workspace:*",
    "three": "catalog:"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
