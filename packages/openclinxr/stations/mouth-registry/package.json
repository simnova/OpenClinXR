{
  "name": "@openclinxr/station-mouth-registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "solver-map": "tsx scripts/generate-solver-map.ts"
  },
  "dependencies": {
    "@openclinxr/station-mouth-executor": "workspace:*",
    "@openclinxr/station-mouth-objective": "workspace:*",
    "@openclinxr/station-mouth-solver-closedform": "workspace:*"
  },
  "devDependencies": {
    "@cellix/config-typescript": "workspace:*",
    "@cellix/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ],
  "openclinxr": {
    "station": "mouth",
    "stationRegistry": true
  }
}
