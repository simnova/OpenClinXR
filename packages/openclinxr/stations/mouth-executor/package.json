{
  "name": "@openclinxr/station-mouth-executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@openclinxr/station-mouth-objective": "workspace:*",
    "@openclinxr/xr-dialogue": "workspace:*",
    "three": "catalog:"
  },
  "devDependencies": {
    "@cellix/config-typescript": "workspace:*",
    "@cellix/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ],
  "openclinxr": {
    "station": "mouth",
    "stationRole": "executor"
  }
}
