{
  "extends": "@cellix/config-typescript/base",
  "compilerOptions": {
    "rootDir": "src",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "types": [
      "node"
    ],
    "noPropertyAccessFromIndexSignature": false,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "dist"
  ]
}
