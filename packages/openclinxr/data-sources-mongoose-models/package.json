{
  "name": "@openclinxr/data-sources-mongoose-models",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "mongoose": "9.6.1",
    "@openclinxr/capability-gateway": "workspace:*"
  },
  "devDependencies": {
    "mongodb-memory-server": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
