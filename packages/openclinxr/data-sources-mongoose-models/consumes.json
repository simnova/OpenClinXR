[
  {
    "provider": "@cellix/config-vitest",
    "entrypoint": "./node",
    "names": [
      {
        "name": "nodeConfig",
        "kind": "runtime"
      }
    ]
  },
  {
    "provider": "@openclinxr/capability-gateway",
    "entrypoint": ".",
    "names": [
      {
        "name": "AzureStorageQueueEncounterAssetMessage",
        "kind": "type"
      },
      {
        "name": "createEncounterAssetGenerationQueueMessage",
        "kind": "runtime"
      },
      {
        "name": "encodeAzureStorageQueueMessage",
        "kind": "runtime"
      },
      {
        "name": "EncounterAssetGenerationQueueMessageEnvelope",
        "kind": "type"
      },
      {
        "name": "EncounterAssetGenerationWorkerExecution",
        "kind": "type"
      },
      {
        "name": "processEncounterAssetGenerationQueueMessage",
        "kind": "runtime"
      }
    ]
  },
  {
    "provider": "@openclinxr/data-sources-mongoose-models",
    "entrypoint": ".",
    "names": [
      {
        "name": "createEncounterAssetGenerationJobModel",
        "kind": "runtime",
        "via": "own-test"
      },
      {
        "name": "EncounterAssetGenerationJobMongooseRepository",
        "kind": "runtime",
        "via": "own-test"
      },
      {
        "name": "ScenarioReviewDecisionRecord",
        "kind": "type",
        "via": "own-test"
      }
    ]
  }
]
