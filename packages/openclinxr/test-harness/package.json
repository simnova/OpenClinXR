{
  "name": "@openclinxr/test-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "openclinxr-bench-mock": "./src/bench-mock.ts"
  },
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "bench:mock": "tsx src/bench-mock.ts",
    "build": "tsgo --build"
  },
  "dependencies": {
    "@openclinxr/model-gateway": "workspace:*",
    "@openclinxr/review-workflow": "workspace:*",
    "@openclinxr/scenario-fixtures": "workspace:*",
    "@openclinxr/scenario-runtime": "workspace:*",
    "@openclinxr/shared-schemas": "workspace:*",
    "@openclinxr/telemetry": "workspace:*",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
