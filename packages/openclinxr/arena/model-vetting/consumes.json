[
  {
    "provider": "@cellix/config-vitest",
    "entrypoint": "./node",
    "names": [
      {
        "name": "nodeConfig",
        "kind": "runtime"
      }
    ]
  },
  {
    "provider": "@openclinxr/asset-registry",
    "entrypoint": ".",
    "names": [
      {
        "name": "resolveMorphTarget",
        "kind": "runtime"
      }
    ]
  },
  {
    "provider": "@openclinxr/model-vetting",
    "entrypoint": ".",
    "names": [
      {
        "name": "AnnyLikePreflightReport",
        "kind": "type",
        "via": "own-test"
      },
      {
        "name": "buildModelVettingReportFromAnnyPreflight",
        "kind": "runtime",
        "via": "own-test"
      },
      {
        "name": "ModelVettingCaptureArtifacts",
        "kind": "type",
        "via": "own-test"
      },
      {
        "name": "validateModelVettingReport",
        "kind": "runtime",
        "via": "own-test"
      }
    ]
  }
]
