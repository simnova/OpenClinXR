{
  "extends": "@cellix/config-typescript/node",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node",
      "vitest"
    ],
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "dist"
  ],
  "references": [
    {
      "path": "../asset-registry"
    },
    {
      "path": "../auth"
    },
    {
      "path": "../capability-gateway"
    },
    {
      "path": "../exam-assembly"
    },
    {
      "path": "../factory-stations"
    },
    {
      "path": "../graphql"
    },
    {
      "path": "../review-workflow"
    },
    {
      "path": "../scenario-fixtures"
    },
    {
      "path": "../scenario-runtime"
    },
    {
      "path": "../shared-schemas"
    },
    {
      "path": "../telemetry"
    },
    {
      "path": "../voice-gateway"
    }
  ]
}
