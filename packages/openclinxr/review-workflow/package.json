{
  "name": "@openclinxr/review-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./accepted-scene-plan-review": {
      "types": "./dist/accepted-scene-plan-review.d.ts",
      "default": "./dist/accepted-scene-plan-review.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "probe:reds": "tsx probe-planted-reds.mts"
  },
  "dependencies": {
    "@openclinxr/domain": "workspace:*",
    "@openclinxr/shared-schemas": "workspace:*"
  },
  "devDependencies": {
    "@openclinxr/scenario-fixtures": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
