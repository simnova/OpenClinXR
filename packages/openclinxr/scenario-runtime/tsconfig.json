    },
    {
      "path": "../conversation-policy"
    },
    {
      "path": "../domain"
    },
    {
      "path": "../exam-assembly"
    },
    {
      "path": "../model-gateway"
    },
    {
      "path": "../review-workflow"
    },
    {
      "path": "../scenario-fixtures"
    },
    {
      "path": "../session-state"
    },
    {
      "path": "../shared-schemas"
    },
    {
      "path": "../voice-gateway"
    }
  ]
