{
  "extends": "@cellix/config-typescript/base",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [
      "node",
      "vitest"
    ],
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "dist"
  ],
  "references": [
    {
      "path": "../graphql"
    },
    {
      "path": "../shared-schemas"
    }
  ]
}
