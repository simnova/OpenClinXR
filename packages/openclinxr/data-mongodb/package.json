{
  "name": "@openclinxr/data-mongodb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --root . --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run --root . integration.test"
  },
  "dependencies": {
    "@openclinxr/asset-registry": "workspace:*",
    "@openclinxr/exam-assembly": "workspace:*",
    "@openclinxr/review-workflow": "workspace:*",
    "@openclinxr/session-state": "workspace:*",
    "@openclinxr/shared-schemas": "workspace:*",
    "mongodb": "catalog:"
  },
  "devDependencies": {
    "@cellix/server-mongodb-memory-mock": "workspace:*",
    "@openclinxr/api": "workspace:*",
    "@openclinxr/graphql": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24"
    }
  }
}
