{
  "name": "@openclinxr/ui-route-shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin-api-client": {
      "types": "./dist/admin-api-client.d.ts",
      "default": "./dist/admin-api-client.js"
    },
    "./admin-api-client-types": {
      "types": "./dist/admin-api-client-types.d.ts",
      "default": "./dist/admin-api-client-types.js"
    },
    "./compile-encounter-world": {
      "types": "./dist/compile-encounter-world.d.ts",
      "default": "./dist/compile-encounter-world.js"
    },
    "./dialogue-seed-types": {
      "types": "./dist/dialogue-seed-types.d.ts",
      "default": "./dist/dialogue-seed-types.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@apollo/client": "4.1.9",
    "@openclinxr/asset-registry": "workspace:*",
    "@openclinxr/exam-assembly": "workspace:*",
    "@openclinxr/graphql": "workspace:*",
    "@openclinxr/rest": "workspace:*",
    "@openclinxr/review-workflow": "workspace:*",
    "@openclinxr/shared-schemas": "workspace:*",
    "@openclinxr/ui-shared": "workspace:*",
    "graphql": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*",
    "vite": "catalog:"
  },
  "files": [
    "dist"
  ]
}
