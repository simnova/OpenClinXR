    "src/xr-sync-c18-cast-trace-replay.test.ts",
    "src/xr-sync-c19-scenario-schedule.test.ts",
    "src/xr-sync-c2-probe.test.ts",
    "src/xr-sync-c20-scenario-rubric.test.ts",
    "src/xr-sync-c21-trace-tag-coverage.test.ts",
    "src/xr-sync-c22-learner-topic-tags.test.ts",
    "src/xr-sync-c22-replay-alignment.test.ts",
    "src/xr-sync-c23-replay-required-count.test.ts",
