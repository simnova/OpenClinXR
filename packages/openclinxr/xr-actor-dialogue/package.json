{
  "name": "@openclinxr/xr-actor-dialogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "tsgo --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@openclinxr/asset-registry": "workspace:*",
    "@openclinxr/scenario-fixtures": "workspace:*",
    "@openclinxr/xr-dialogue": "workspace:*",
    "@openclinxr/xr-humanoid-animation": "workspace:*",
    "@openclinxr/xr-runtime-state": "workspace:*",
    "@openclinxr/xr-trace-readiness": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
