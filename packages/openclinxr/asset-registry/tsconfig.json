{
  "extends": "@cellix/config-typescript/node",
  "compilerOptions": {
    "rootDir": "src",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts",
    "src/measured-station-geometry.json"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "dist"
  ],
  "references": [
    {
      "path": "../scenario-fixtures"
    },
    {
      "path": "../shared-schemas"
    }
  ]
}
