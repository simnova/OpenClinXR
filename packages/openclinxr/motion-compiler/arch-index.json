    "src/the-contact-constraint-holds-across-its-window.test.ts",
    "src/the-contact-surface-bounds-penetration-and-orientation.test.ts",
    "src/the-four-response-kinds-are-four-behaviours.test.ts",
    "src/the-guard-primitive-hits-four-targets-on-three-rigs.test.ts",
