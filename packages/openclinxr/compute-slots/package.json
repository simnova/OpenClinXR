{
  "name": "@openclinxr/compute-slots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "default": "./dist/slots.js"
    }
  },
  "scripts": {
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "cellix-tsc --noEmit -p tsconfig.vitest.json",
    "test": "vitest run --root .",
    "build": "cellix-tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@cellix/config-typescript": "workspace:*",
    "@cellix/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "files": [
    "dist"
  ]
}
