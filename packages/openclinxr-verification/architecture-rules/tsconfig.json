    "outDir": "dist",
    "types": [
      "node",
      "vitest"
    ],
    "composite": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../openclinxr/capability-gateway"
    },
    {
      "path": "../../openclinxr/domain"
    }
  ]
}
