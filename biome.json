{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "packages/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "tools/**/*.{ts,tsx,js,jsx,json,jsonc}",
      "*.json",
      "*.jsonc"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noVar": "error",
        "noConfusingVoidType": "error",
        "noDebugger": "error",
        "noExtraNonNullAssertion": "error",
        "noFallthroughSwitchClause": "error",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noImplicitAnyLet": "warn",
        "noArrayIndexKey": "warn",
        "noControlCharactersInRegex": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useYield": "warn",
        "noVoidTypeReturn": "warn",
        "noPrecisionLoss": "warn"
      },
      "a11y": {
        "useAriaPropsSupportedByRole": "warn",
        "noLabelWithoutControl": "warn"
      },
      "style": {
        "noCommonJs": "error",
        "noNamespace": "error",
        "noNonNullAssertion": "warn",
        "useImportType": "error",
        "useConst": "error",
        "useAsConstAssertion": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/openclinxr/graphql/src/generated/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tools/agent-factory/check-typescript-guardrails.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/openclinxr/rest/src/**",
        "packages/openclinxr/xr-scene/src/**",
        "packages/openclinxr/xr-capture-evidence/src/**",
        "packages/openclinxr/xr-humanoid-animation/src/**",
        "packages/openclinxr/xr-locomotion/src/**",
        "packages/openclinxr/xr-runtime-wiring/src/**",
        "packages/openclinxr/xr-scene-cues/src/**",
        "packages/openclinxr/xr-trace-readiness/src/**",
        "packages/openclinxr/xr-asset-loading/src/**",
        "packages/openclinxr/xr-actor-dialogue/src/**",
        "packages/openclinxr/xr-station-room/src/**",
        "packages/openclinxr/ui-route-admin/src/**",
        "apps/ui-admin/src/**",
        "apps/ui-xr/src/**",
        "packages/openclinxr-verification/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off",
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
