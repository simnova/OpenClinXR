  "signal": "log Y (linear-light Y via room_exposure.srgb_to_linear/luminance_Y) inside the FaceLandmarker forehead polygon, same region/H/logY as wrinkle_bands.analyse",
  "window": "mean-subtracted, 2D Hann (np.hanning outer product)",
  "spectrum": "rfft2 power |F|^2, radially AVERAGED (mean power per radial bin; differs from wrinkle's max-magnitude FFT prominence profile); empty radial bins (no samples on small patches) are linearly interpolated from populated neighbours, count recorded per image. NO smoothing: a Daniell +-4 amendment was tried and REVERTED because it buried the goal pore line (goal_body2 raw argmax bin 140, 4.6 px wavelength, matches the visible pores and the card title's finer-frequency premise) under the mottling bump (bin 37), flipping the fix direction against the card; raw numbers from the smoothing trial are superseded, retained in the launcher log only",
  "caveat_goal_body2_near_tie": "raw goal_body2 argmax bin 140 (30.22) beats bin 37 (29.76) by 1.5pc: the pore line vs the mottling bump. Title premise + visible ~5px pores + falsifier select 140; recorded as a fragility",
  "frequency": "cycles per face height H = ||P10-P152|| px; rfft grid normalised per axis (fx_H = kx*H/W, fy_H = ky*H/Hpatch); radial bins 1 cycle/H wide",
  "pore_band_cycles_per_H": [
   20.69,
   238.73
  ],
  "pore_band_source": "wrinkle's pore sigmas H/1500..H/130 via the Gaussian characteristic-frequency rule f = 1/(2*pi*sigma)",
  "peak": "argmax of mean power inside the band, parabolically refined on log-power; cycles/H",
  "noise_floor": "median mean-power over f in [0.9*f_hi, f_hi] of the PHOTO spectrum",
  "falsifier": "goal peak power >= 2.0x its photo floor (margin mirrors the wrinkle 2x-PRE prominence rule); else record and stop",
  "floor_margin": 2.0
 },
