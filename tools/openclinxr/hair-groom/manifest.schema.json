{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "openclinxr.hair-groom.manifest.v1",
  "description": "Immutable inputs for the hair-groom station runner. Every external input is pinned by path + sha256. The station regenerates the groom from these inputs only.",
  "type": "object",
  "required": ["schemaVersion", "body", "targets", "camerasFile", "cameras", "style", "seed"],
  "properties": {
    "schemaVersion": {"type": "string", "enum": ["openclinxr.hair-groom.manifest.v1"]},
    "body": {
      "type": "object",
      "required": ["id", "glb", "sha256"],
      "properties": {
        "id": {"type": "string"},
        "glb": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "targets": {
      "type": "object",
      "required": ["landmarks", "masks"],
      "properties": {
        "landmarks": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "masks": {
          "type": "object",
          "required": ["front", "profile_90", "back"],
          "properties": {
            "front": {"$ref": "#/properties/targets/properties/landmarks"},
            "profile_90": {"$ref": "#/properties/targets/properties/landmarks"},
            "back": {"$ref": "#/properties/targets/properties/landmarks"}
          }
        }
      }
    },
    "camerasFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["front", "three_quarter", "profile_90", "back", "crown_top"]}
    },
    "style": {
      "type": "object",
      "required": ["part", "families"],
      "properties": {
        "part": {"type": "string", "enum": ["centre", "left", "right"]},
        "families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "mirror"],
            "properties": {
              "name": {"type": "string"},
              "mirror": {"type": ["boolean", "string"]}
            }
          }
        }
      }
    },
    "seed": {"type": "integer"}
  }
}
