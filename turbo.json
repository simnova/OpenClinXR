{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "boundaries": {
    "tags": {
      "production": {
        "dependencies": {
          "deny": [
            "arena"
          ]
        }
      },
      "internal": {
        "dependencies": {
          "deny": [
            "arena"
          ]
        }
      },
      "cellix": {
        "dependencies": {
          "deny": [
            "arena",
            "production"
          ]
        },
        "dependents": {
          "deny": [
            "arena",
            "production"
          ]
        }
      }
    }
  },
  "globalDependencies": [
    "biome.json",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "tsconfig.archunit.json",
    "tsconfig.ide.json",
    "vitest.config.ts"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "CELLIX_VITEST_MAX_WORKERS",
    "OPENCLINXR_HEAVY_SLOT_HELD"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "//#gen"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "package.json",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test.mjs",
        "!**/*.spec.ts",
        "!**/__tests__/**",
        "!tests/**",
        "!vitest.config.ts",
        "!vitest.*.config.ts",
        "!tsconfig.vitest.json"
      ],
      "outputs": [
        "dist/**",
        "deploy/**",
        "*.tsbuildinfo"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "$TURBO_ROOT$/biome.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.test.ts",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": []
    },
    "architecture": {
      "cache": false,
      "dependsOn": [
        "^typecheck",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/archunit-tests/**/*.test.ts",
        "vitest.arch.config.ts",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [],
      "passThroughEnv": [
        "OPENCLINXR_HOOK_STAGED_FILES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#test:tools:serial-browser": {
      "cache": true,
      "inputs": [
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr/arena/model-vetting/**",
        "packages/openclinxr/asset-registry/src/**",
        "packages/openclinxr/capability-gateway/src/**",
        "packages/openclinxr/model-gateway/src/**",
        "packages/openclinxr/scenario-fixtures/src/**",
        "packages/openclinxr/scenario-runtime/src/**",
        "packages/openclinxr/shared-schemas/src/**",
        "tools/agent-factory/lib.ts",
        "tools/openclinxr/asset-pipeline/**",
        "tools/openclinxr/dark-factory/**",
        "tools/openclinxr/evidence/**",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/factory/**",
        "tools/openclinxr/openclaw/**",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:serial-spawn": {
      "cache": true,
      "inputs": [
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr/agent-loop/src/**",
        "tests/openclinxr/helpers/assembled-exam-harness.ts",
        "tools/openclinxr/asset-pipeline/**",
        "tools/openclinxr/evidence/**",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/mouth-solver/**",
        "tools/openclinxr/openclaw/**",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:serial-blender": {
      "cache": true,
      "inputs": [
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr/asset-registry/src/**",
        "packages/openclinxr/capability-gateway/src/**",
        "tools/agent-factory/benchmark-gate-report.test.ts",
        "tools/agent-factory/build-benchmark-gate-report.ts",
        "tools/agent-factory/lib.ts",
        "tools/openclinxr/evidence/**",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/factory/**",
        "tools/openclinxr/openclaw/**",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:evidence": {
      "cache": true,
      "inputs": [
        "apps/api/src/api-bootstrap.ts",
        "apps/api/src/api-fetch-transport.ts",
        "apps/api/src/app.ts",
        "apps/api/src/index.ts",
        "apps/api/src/scenario-promotion-bridge.ts",
        "apps/arena/mock-realtime-voice-server/src/**",
        "apps/arena/model-vetting-studio/src/**",
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr/agent-loop/src/**",
        "packages/openclinxr/asset-registry/src/**",
        "packages/openclinxr/capability-gateway/src/**",
        "packages/openclinxr/exam-assembly/src/**",
        "packages/openclinxr/factory-stations/src/**",
        "packages/openclinxr/graphql/src/**",
        "packages/openclinxr/model-gateway/src/**",
        "packages/openclinxr/rest/src/**",
        "packages/openclinxr/scenario-fixtures/src/**",
        "packages/openclinxr/scenario-runtime/src/**",
        "packages/openclinxr/session-state/src/**",
        "packages/openclinxr/shared-schemas/src/**",
        "packages/openclinxr/telemetry/src/**",
        "packages/openclinxr/ui-route-admin/src/**",
        "packages/openclinxr/voice-gateway/src/**",
        "packages/openclinxr/xr-dialogue/dist/**",
        "packages/openclinxr/xr-dialogue/src/**",
        "packages/openclinxr/xr-humanoid-animation/dist/**",
        "packages/openclinxr/xr-humanoid-animation/src/**",
        "packages/openclinxr/xr-pose/src/**",
        "packages/openclinxr/xr-runtime-state/src/**",
        "packages/openclinxr/xr-scene/dist/**",
        "packages/openclinxr/xr-scene/src/**",
        "packages/openclinxr/xr-station-room/src/**",
        "packages/openclinxr/xr-station/src/**",
        "tools/agent-factory/build-generated-artifact-registry.ts",
        "tools/agent-factory/generated-artifact-preserved-entries.ts",
        "tools/agent-factory/lib.ts",
        "tools/agent-factory/registry-shrink-guard.ts",
        "tools/openclinxr/asset-pipeline/**",
        "tools/openclinxr/evidence/**",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/factory/**",
        "tools/openclinxr/mouth-solver/**",
        "tools/openclinxr/openclaw/**",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:asset-pipeline": {
      "cache": true,
      "inputs": [
        "packages/cellix/config-vitest/src/**",
        "tools/openclinxr/asset-pipeline/**",
        "tools/openclinxr/evidence/browser-boot-inventory.ts",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/openclaw/project-test-scope.ts",
        "tools/openclinxr/openclaw/run-tools-tests.ts",
        "tools/openclinxr/openclaw/tools-test-areas.ts",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:agent-factory": {
      "cache": true,
      "inputs": [
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr/arena/iwsdk-spike/**",
        "tools/agent-factory/a-cited-evidence-path-must-exist-in-head.test.ts",
        "tools/agent-factory/a-new-doc-does-not-edit-the-root-registry.test.ts",
        "tools/agent-factory/archived-reasoning-is-cited-by-anchor-not-line.test.ts",
        "tools/agent-factory/build-doc-authority-registry.ts",
        "tools/agent-factory/build-maturity-report.test.ts",
        "tools/agent-factory/build-maturity-report.ts",
        "tools/agent-factory/build-memory-index.test.ts",
        "tools/agent-factory/build-memory-index.ts",
        "tools/agent-factory/check-benchmark-gate-evidence-ids.test.ts",
        "tools/agent-factory/check-benchmark-gate-evidence-ids.ts",
        "tools/agent-factory/check-coordination-alignment.test.ts",
        "tools/agent-factory/check-coordination-alignment.ts",
        "tools/agent-factory/check-openclaw-drift.test.ts",
        "tools/agent-factory/check-openclaw-drift.ts",
        "tools/agent-factory/check-openclaw-operational-redundancy.test.ts",
        "tools/agent-factory/check-openclaw-operational-redundancy.ts",
        "tools/agent-factory/check-openclaw-readiness.test.ts",
        "tools/agent-factory/check-openclaw-readiness.ts",
        "tools/agent-factory/check-pinned-dependencies.test.ts",
        "tools/agent-factory/check-pinned-dependencies.ts",
        "tools/agent-factory/check-source-ledger.test.ts",
        "tools/agent-factory/check-source-ledger.ts",
        "tools/agent-factory/cited-evidence-baseline.json",
        "tools/agent-factory/find-evidence-debt.test.ts",
        "tools/agent-factory/find-evidence-debt.ts",
        "tools/agent-factory/lib.ts",
        "tools/agent-factory/registry-shrink-guard.ts",
        "tools/agent-factory/report-tool-import-contract.test.ts",
        "tools/agent-factory/the-authority-scan-excludes-generated-slice-prompts.test.ts",
        "tools/agent-factory/the-claude-startup-context-stays-small.test.ts",
        "tools/agent-factory/the-harness-sync-never-deletes-a-tracked-file.test.ts",
        "tools/agent-factory/the-installed-lane-rules-keep-the-operators-decisions.test.ts",
        "tools/openclinxr/evidence/browser-boot-inventory.ts",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/openclaw/**",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:openclaw": {
      "cache": true,
      "inputs": [
        ".claude/hooks/bothy-board-token-guard.js",
        ".claude/hooks/skill-preflight.js",
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr-verification/architecture-rules/src/**",
        "packages/openclinxr/agent-loop/src/**",
        "packages/openclinxr/asset-registry/src/**",
        "tools/agent-factory/build-doc-authority-registry.ts",
        "tools/agent-factory/registry-shrink-guard.ts",
        "tools/openclinxr/evidence/browser-boot-inventory.ts",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/openclaw/**",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#test:tools:misc": {
      "cache": true,
      "inputs": [
        "packages/cellix/config-vitest/src/**",
        "packages/openclinxr-verification/architecture-rules/src/**",
        "packages/openclinxr/arena/model-vetting/**",
        "packages/openclinxr/arena/physics-touch-contract/**",
        "packages/openclinxr/asset-registry/src/**",
        "packages/openclinxr/capability-gateway/src/**",
        "packages/openclinxr/data-mongodb/src/**",
        "packages/openclinxr/data-sources-mongoose-models/src/**",
        "packages/openclinxr/model-gateway/dist/**",
        "packages/openclinxr/scenario-fixtures/src/**",
        "packages/openclinxr/scenario-runtime/src/**",
        "packages/openclinxr/shared-schemas/src/**",
        "packages/openclinxr/xr-dialogue/dist/**",
        "packages/openclinxr/xr-dialogue/src/**",
        "tools/agent-factory/lib.ts",
        "tools/openclinxr/admin-replay-from-emission.test.ts",
        "tools/openclinxr/admin-replay-from-emission.ts",
        "tools/openclinxr/asset-pipeline/**",
        "tools/openclinxr/dark-factory/**",
        "tools/openclinxr/encounter-runtime-emission.test.ts",
        "tools/openclinxr/encounter-runtime-emission.ts",
        "tools/openclinxr/evidence/**",
        "tools/openclinxr/evidence/browser-boot-inventory/**",
        "tools/openclinxr/factory/**",
        "tools/openclinxr/mouth-solver/**",
        "tools/openclinxr/openclaw/project-test-scope.ts",
        "tools/openclinxr/openclaw/run-tools-tests.ts",
        "tools/openclinxr/openclaw/tools-test-areas.ts",
        "tools/openclinxr/staging-solver/**",
        "tools/openclinxr/the-licence-ledger-migration-lost-nothing.test.ts",
        "tsconfig.tools-relaxed.json",
        "vitest.config.ts"
      ],
      "outputs": []
    },
    "//#gen": {
      "description": "Runs @openclinxr/graphql generate (static SDL artifacts + graphql-codegen resolvers/client)",
      "cache": true,
      "inputs": [
        "packages/openclinxr/graphql/codegen.ts",
        "packages/openclinxr/graphql/package.json",
        "packages/openclinxr/graphql/scripts/**",
        "packages/openclinxr/graphql/src/**/*.graphql",
        "packages/openclinxr/graphql/src/**/*.ts",
        "!packages/openclinxr/graphql/src/generated/**",
        "!**/*.generated.ts",
        "!packages/openclinxr/graphql/src/**/*.test.ts"
      ],
      "outputs": [
        "packages/openclinxr/graphql/src/generated/**"
      ]
    }
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  }
}
