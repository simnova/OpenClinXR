{
  "$schema": "https://turborepo.dev/schema.json",
  "remoteCache": {
    "enabled": true
  },
  "boundaries": {
    "tags": {
      "production": {
        "dependencies": {
          "deny": [
            "arena"
          ]
        }
      },
      "internal": {
        "dependencies": {
          "deny": [
            "arena"
          ]
        }
      },
      "cellix": {
        "dependencies": {
          "deny": [
            "arena",
            "production"
          ]
        },
        "dependents": {
          "deny": [
            "arena",
            "production"
          ]
        }
      }
    }
  },
  "globalDependencies": [
    "biome.json",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.base.json",
    "tsconfig.archunit.json",
    "tsconfig.ide.json",
    "vitest.config.ts"
  ],
  "globalEnv": [
    "CI",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "//#gen"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [
        "dist/**",
        "deploy/**",
        "*.tsbuildinfo"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "package.json",
        "$TURBO_ROOT$/biome.json"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "**/*.test.ts",
        "vitest.config.ts",
        "package.json"
      ],
      "outputs": []
    },
    "architecture": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/archunit-tests/**/*.test.ts",
        "vitest.arch.config.ts",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": [],
      "passThroughEnv": [
        "OPENCLINXR_HOOK_STAGED_FILES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#test:tools": {
      "inputs": [
        "tools/**/*.ts",
        "vitest.config.ts",
        "tsconfig.tools-relaxed.json"
      ],
      "outputs": []
    },
    "//#gen": {
      "description": "Runs @openclinxr/graphql generate (static SDL artifacts + graphql-codegen resolvers/client)",
      "cache": true,
      "inputs": [
        "packages/openclinxr/graphql/codegen.ts",
        "packages/openclinxr/graphql/package.json",
        "packages/openclinxr/graphql/scripts/**",
        "packages/openclinxr/graphql/src/**/*.graphql",
        "packages/openclinxr/graphql/src/**/*.ts",
        "!packages/openclinxr/graphql/src/generated/**",
        "!**/*.generated.ts",
        "!packages/openclinxr/graphql/src/**/*.test.ts"
      ],
      "outputs": [
        "packages/openclinxr/graphql/src/generated/**"
      ]
    }
  },
  "futureFlags": {
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true
  }
}
