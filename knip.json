{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "package.json",
    "tools/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
    "apps/**/src/{main,index}.{ts,tsx}",
    "apps/**/src/*-shot-main.tsx",
    "apps/**/src/*-measure.ts",
    "apps/**/src/isolated-*.ts",
    "apps/**/scripts/**/*.{ts,mjs,cjs}",
    "packages/**/src/cli/**/*.{ts,mts,mjs}",
    "packages/openclinxr/xr-capacity/src/controller/entry.ts",
    "packages/openclinxr/xr-capacity/src/stage0/entry.ts",
    "packages/openclinxr/xr-capacity/src/stage1/shell/entry.ts",
    "packages/openclinxr/xr-capacity/src/stage1-witnessed/shell/entry.ts",
    "packages/openclinxr/xr-capacity/src/stage1/audio/host-sanity.mjs",
    "**/vitest.config.ts",
    "**/vitest.arch.config.ts"
  ],
  "project": [
    "vitest.config.ts",
    "apps/**/*.{ts,tsx,js,jsx,mjs,cjs}",
    "packages/**/*.{ts,tsx,js,jsx,mjs,cjs}",
    "tools/**/*.{ts,tsx,js,jsx,mjs,cjs}"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        "tools/**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}",
        "apps/**/src/{main,index}.{ts,tsx}",
        "apps/**/src/*-shot-main.tsx",
        "apps/**/src/*-measure.ts",
        "apps/**/src/isolated-*.ts",
        "apps/**/scripts/**/*.{ts,mjs,cjs}",
        "packages/**/src/cli/**/*.{ts,mts,mjs}",
        "**/vitest.config.ts",
        "**/vitest.arch.config.ts"
      ],
      "project": [
        "vitest.config.ts",
        "tools/**/*.{ts,tsx,js,jsx,mjs,cjs}"
      ]
    },
    "apps/ui-xr": {
      "ignoreDependencies": ["@openclinxr/xr-capacity"]
    },
    "apps/arena/ui-xr-iwsdk-spike": {
      "entry": ["src/main.ts", "src/sync-probe/sync-probe.ts"]
    },
    "packages/openclinxr/xr-capacity": {
      "entry": [
        "src/controller/entry.ts",
        "src/stage0/entry.ts",
        "src/stage1/shell/entry.ts",
        "src/stage1-witnessed/shell/entry.ts",
        "src/stage1/audio/host-sanity.mjs"
      ]
    },
    "packages/openclinxr/xr-humanoid-animation": {
      "entry": [
        "src/fixed-clock-query-flag-mod.ts"
      ]
    },
    "packages/openclinxr/xr-sync-server": {
      "entry": [
        "src/dev-server.ts"
      ]
    }
  },
  "ignore": [
    ".claude/**",
    "**/generated/**",
    "**/dist/**",
    "apps/api/scripts/**",
    "apps/ui-admin/src/*-shot-main.tsx",
    "apps/ui-xr/src/articulating-hob-measure.ts",
    "apps/ui-xr/src/isolated-*.ts",
    "packages/openclinxr/arena/physics-touch-contract/src/cli/**",
    "packages/openclinxr/factory-stations/src/room_chain/**",
    "packages/openclinxr/factory-stations/src/face_realism/run-case.ts",
    "packages/openclinxr/asset-registry/src/resolved-phenotype-field.ts",
    "packages/openclinxr/motion-compiler/src/derive-skeleton-profile.ts",
    "packages/openclinxr/motion-compiler/src/regions/region-anchors.ts",
    "packages/openclinxr/review-workflow/src/planted.ts",
    "tools/openclinxr/evidence/room-bake-harness.test.ts",
    ".openclinxr/slices/**/evidence/**/files/**"
  ],
  "ignoreDependencies": [
    "@gltf-transform/cli",
    "@gltf-transform/extensions",
    "@gltf-transform/functions",
    "@iwsdk/scene-composition",
    "@knip/language-server",
    "@pmndrs/uikit",
    "@vitest/coverage-v8",
    "archunit",
    "gltf-pipeline",
    "gltfpack",
    "pyright",
    "sharp",
    "typescript-language-server"
  ],
  "ignoreBinaries": [
    "agent-browser",
    "blender",
    "gh",
    "portless",
    "python3"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "unlisted": "error",
    "unresolved": "error",
    "binaries": "error",
    "duplicates": "error",
    "catalog": "off",
    "exports": "off",
    "nsExports": "off",
    "types": "off",
    "nsTypes": "off",
    "enumMembers": "off",
    "namespaceMembers": "off"
  },
  "ignoreIssues": {
    "apps/ui-admin/src/environment-generation-queue-panel.tsx": ["types"],
    "apps/ui-admin/src/faculty-review-decision-panel.tsx": ["types"],
    "apps/ui-admin/src/review-replay-readiness-summary-panel.tsx": ["types"],
    "apps/ui-admin/src/review-replay-safety-panel.tsx": ["types"],
    "apps/ui-admin/src/runtime-selection-review-packet-panel.tsx": ["types"],
    "apps/ui-admin/src/scenario-bank-maturity-panel.tsx": ["types"],
    "apps/ui-admin/src/seed-exam-readiness-boundary-panel.tsx": ["types"],
    "apps/ui-admin/src/api-client.ts": ["exports", "types"],
    "apps/arena/ui-xr-iwsdk-spike/src/mixed-reality-state.ts": ["types"],
    "apps/arena/ui-xr-iwsdk-spike/src/uikitml-spatial-text.ts": ["types"],
    "apps/ui-xr/src/api-client.ts": ["types"],
    "packages/openclinxr/shared-schemas/src/schemas.ts": ["duplicates", "exports", "types"],
    "packages/cellix/provider-contracts/src/index.ts": ["duplicates"],
    "packages/openclinxr/motion-compiler/package.json": ["dependencies"],
    "packages/openclinxr/stations/runtime-scene-evidence/package.json": ["devDependencies"],
    "packages/openclinxr/stations/anny-phenotype-evidence/package.json": ["dependencies"],
    "packages/openclinxr/stations/local-runtime-evidence/package.json": ["dependencies"],
    "packages/openclinxr/stations/slide-phase-evidence/package.json": ["dependencies"],
    "packages/openclinxr/test-harness/src/benchmark-report.ts": ["types"],
    "tools/agent-factory/agent-loop-plan.ts": ["types"],
    "tools/agent-factory/agent-roster.ts": ["types"],
    "tools/openclinxr/encounter-runtime-handoff-adapter.ts": ["types"],
    "tools/openclinxr/media-artifact-integrity.ts": ["exports", "types"],
    "tools/openclinxr/provider-boundary-notes.ts": ["types"]
  }
}
