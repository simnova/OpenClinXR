{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/skill-preflight.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pnpm exec tsx tools/openclinxr/openclaw/context-cap.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec tsx tools/openclinxr/openclaw/context-cap.ts",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__bothy-board__bothy-board_(sync|mailbox_poll)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bothy-board-token-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__bothy-board__bothy-board_(sync|mailbox_poll)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/bothy-board-token-guard.js\" --post",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["bothy-board"]
}
