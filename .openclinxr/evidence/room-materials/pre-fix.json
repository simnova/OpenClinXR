{
  "schemaVersion": "openclinxr.room-materials.pre-fix.v1",
  "kind": "room_materials_pre_fix_census",
  "measuredAt": "2026-08-12T14:20:58.069Z",
  "measuredAgainstCommit": "4cf456353bb164adf0f232d7c3c3bae83555b929",
  "answerFirst": {
    "question": "Do the shipped rooms have per-surface material assignment to differentiate?",
    "parametricShell": {
      "hasPerSurfaceAssignment": true,
      "detail": "15 named materials map 1:1 to surfaces (floor/wall/rail/equipment/linen/light/mattress/metal/paper/screen/tape/scuff/signage). Differentiation IS possible in the emitter."
    },
    "infinigenRoom": {
      "hasPerSurfaceAssignment": true,
      "detail": "4 meshes: wall(plaster), floor(ceramic tile), ceiling(plaster), exterior(NO material). Roughness already non-uniform (0.70/1.0/0.80) from the generator. White baseColor = albedo lost at extraction (#345 lane). Exterior unassigned."
    },
    "blockedOnExtraction346": false,
    "conclusion": "NOT blocked. Per-surface assignment exists in both shipped rooms. This slice differentiates PBR channels in the parametric shell emitter; the Infinigen room's remaining defects (white albedo, unassigned exterior) belong to #345 (bake) / #346 (extraction) lanes whose briefs explicitly exclude material roughness assignment."
  },
  "measuredFinding": {
    "emitterColorsDoNotSurviveExport": {
      "detail": "createEnvironmentBlenderScript sets mat.diffuse_color (viewport display) which the glTF exporter ignores; every material exports Principled BSDF default baseColor [0.8,0.8,0.8,1]. Controlled probe confirmed: diffuse_color-only control exports 0.8 gray.",
      "probed": "blender --background probe: control(diffuse_color) -> baseColor 0.8, roughness 0.5, metallic 0; treatment(Principled BSDF Roughness/Metallic) -> roughness 0.35, metallic 1.0 survives."
    },
    "allShippedShellMaterialsIdenticalPbr": {
      "detail": "All 15 parametric shell materials export roughness=0.5, metallic=0, baseColor=0.8 gray — literally the same plastic."
    }
  },
