      "ceilingBytes": 28063115,
      "ceilingFiles": null,
      "targetBytes": 1500000,
      "targetFiles": null
    },
    "E": {
      "kind": "evidence code",
      "globs": [
        "tools/openclinxr/evidence/**",
        "packages/openclinxr/stations/*-evidence/**"
