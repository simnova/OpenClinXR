    "P": {
      "kind": "product",
      "globs": [],
      "ceilingBytes": null,
      "ceilingFiles": null,
      "targetBytes": null,
      "targetFiles": null
    }
  },
  "rules": {
    "offsetRatio": 2,
    "ruleNames": ["ceiling", "offset", "d-growth", "pin", "exception"],
    "dGrowth": "D may not add files or bytes at all (governed by rule d-growth, not by offset).",
    "offset": "While a bucket with targetBytes is above its target, added bytes must be matched by >= offsetRatio x removed bytes from the SAME bucket.",
    "pinBan": "Added lines (diff vs base) in pinBan paths must not contain a 64-hex sha256 next to a .glb/.png/.py/.npz path, nor a <file>.py:<line> / .ts:<line> citation."
  },
  "pinBan": {
    "pathGlobs": ["*.test.*", "*.json"],
    "buckets": ["E", "G", "P"]
  },
