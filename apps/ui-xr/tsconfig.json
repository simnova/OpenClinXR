{
  "extends": "@cellix/config-typescript/base",
  "compilerOptions": {
    "rootDir": "src",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noPropertyAccessFromIndexSignature": false,
    "composite": true
  },
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/openclinxr/asset-registry"
    },
    {
      "path": "../../packages/openclinxr/conversation-policy"
    },
    {
      "path": "../../packages/openclinxr/exam-assembly"
    },
    {
      "path": "../../packages/openclinxr/scenario-fixtures"
    },
    {
      "path": "../../packages/openclinxr/shared-schemas"
    }
  ]
}
