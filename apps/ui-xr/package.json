{
  "name": "@openclinxr/ui-xr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:portless": "vite --host 127.0.0.1 --port ${PORT:-0} --strictPort=false",
    "build": "vite build",
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@openclinxr/asset-registry": "workspace:*",
    "@openclinxr/conversation-policy": "workspace:*",
    "@openclinxr/exam-assembly": "workspace:*",
    "@openclinxr/scenario-fixtures": "workspace:*",
    "@openclinxr/shared-schemas": "workspace:*",
    "@openclinxr/xr-station": "workspace:*",
    "@openclinxr/xr-runtime-state": "workspace:*",
    "@openclinxr/xr-dialogue": "workspace:*",
    "@openclinxr/xr-pose": "workspace:*",
    "three": "catalog:",
    "@openclinxr/xr-scene": "workspace:*",
    "@openclinxr/xr-scene-cues": "workspace:*",
    "@openclinxr/xr-capture-evidence": "workspace:*",
    "@openclinxr/xr-humanoid-animation": "workspace:*",
    "@openclinxr/xr-locomotion": "workspace:*",
    "@openclinxr/xr-runtime-wiring": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  }
}
