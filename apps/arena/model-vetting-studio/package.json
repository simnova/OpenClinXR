{
  "name": "@openclinxr/model-vetting-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:portless": "vite --host 127.0.0.1 --port ${PORT:-5184} --strictPort",
    "build": "vite build",
    "lint": "biome check --no-errors-on-unmatched .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@openclinxr/model-vetting": "workspace:*",
    "antd": "6.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.5"
  }
}
