{
  "name": "@openclinxr/ui-xr-iwsdk-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:portless": "vite --host 127.0.0.1 --port ${PORT:-0} --strictPort=false",
    "build": "vite build",
    "probe:iwsdk": "node scripts/probe-iwsdk.mjs",
    "lint": "biome lint --no-errors-on-unmatched .",
    "typecheck": "cellix-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ."
  },
  "dependencies": {
    "@iwsdk/core": "0.4.2",
    "@iwsdk/xr-input": "0.4.2",
    "@openclinxr/iwsdk-spike": "workspace:*",
    "@openclinxr/scenario-fixtures": "workspace:*",
    "three": "catalog:"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "0.3.1",
    "@iwsdk/vite-plugin-uikitml": "0.4.2",
    "@pmndrs/uikit": "1.0.74",
    "@pmndrs/uikitml": "0.1.12",
    "@types/three": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@cellix/config-vitest": "workspace:*",
    "@cellix/config-typescript": "workspace:*"
  }
}
